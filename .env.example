# MongoDB Atlas connection string (used by the new bot approval/catalog API)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/teddytech_deployer?retryWrites=true&w=majority
MONGODB_DB_NAME=teddytech_deployer

# Required by the legacy dashboard API in this reference snapshot. The original
# application still uses Drizzle/PostgreSQL for its existing auth/wallet/deployments.
# A complete MongoDB migration of those legacy routes is not included yet.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Random secret, minimum 32 characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Heroku and Paystack secrets must remain server-side
HEROKU_API_KEY=
PAYSTACK_SECRET_KEY=

# Telegram bot used for review/approval notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
FRONTEND_URL=https://your-project.vercel.app
NODE_ENV=production
